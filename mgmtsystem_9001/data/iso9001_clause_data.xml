            <field name="sequence">23</field>
        </record>
        <record id="iso9001_clause_5_2" model="iso9001.clause">
            <field name="name">Kvalitetspolicy</field>
            <field name="clause_number">5.2</field>
            <field name="parent_id" ref="iso9001_clause_5"/>
            <field name="description">Högsta ledningen ska upprätta en kvalitetspolicy som är lämplig för organisationens syfte och förutsättningar, stöder den strategiska inriktningen, och innehåller ett åtagande om ständig förbättring.</field>
            <field name="sequence">24</field>
        </record>
        <record id="iso9001_clause_5_3" model="iso9001.clause">
            <field name="name">Organisatoriska roller, ansvar och befogenheter</field>
            <field name="clause_number">5.3</field>
            <field name="parent_id" ref="iso9001_clause_5"/>
            <field name="description">Högsta ledningen ska säkerställa att ansvar och befogenheter för relevanta roller är tilldelade, kommunicerade och förstådda. Inkluderar rapportering av förbättringsmöjligheter till högsta ledningen.</field>
            <field name="sequence">25</field>
        </record>

