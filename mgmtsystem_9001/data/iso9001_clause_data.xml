        <!-- ISO 9001:2026 Clauses — Swedish -->
        <!-- Clause 4: Context of the Organization -->
        <record id="iso9001_clause_4" model="iso9001.clause">
            <field name="name">Organisationens förutsättningar</field>
            <field name="clause_number">4</field>
            <field name="sequence">10</field>
        </record>
        <record id="iso9001_clause_4_1" model="iso9001.clause">
            <field name="name">Förstå organisationen och dess förutsättningar</field>
            <field name="clause_number">4.1</field>
            <field name="parent_id" ref="iso9001_clause_4"/>
            <field name="description">Organisationen ska fastställa externa och interna förutsättningar som är relevanta för dess syfte och strategiska inriktning, och som påverkar förmågan att uppnå avsedda resultat i kvalitetsledningssystemet. Klimatförändringar har beaktats.</field>
            <field name="sequence">11</field>
        </record>
        <record id="iso9001_clause_4_2" model="iso9001.clause">
            <field name="name">Intressenters behov och förväntningar</field>
            <field name="clause_number">4.2</field>
            <field name="parent_id" ref="iso9001_clause_4"/>
            <field name="description">Organisationen ska fastställa relevanta intressenter och deras relevanta krav.</field>
            <field name="sequence">12</field>
        </record>
        <record id="iso9001_clause_4_3" model="iso9001.clause">
            <field name="name">Omfattning av kvalitetsledningssystemet</field>
            <field name="clause_number">4.3</field>
            <field name="parent_id" ref="iso9001_clause_4"/>
            <field name="sequence">13</field>
        </record>
        <record id="iso9001_clause_4_4" model="iso9001.clause">
            <field name="name">Kvalitetsledningssystemet och dess processer</field>
            <field name="clause_number">4.4</field>
            <field name="parent_id" ref="iso9001_clause_4"/>
            <field name="description">Organisationen ska upprätta, införa, underhålla och ständigt förbättra ett kvalitetsledningssystem, inklusive nödvändiga processer och deras samverkan.</field>
            <field name="sequence">14</field>
        </record>

