            <field name="parent_id" ref="iso9001_clause_5_1"/>
            <field name="description">Högsta ledningen ska visa ledarskap och engagemang genom att främja kvalitetskultur och etiskt beteende, ta ansvar för ledningssystemets effektivitet, och säkerställa integration i verksamhetsprocesser.</field>
            <field name="sequence">22</field>
        </record>
        <record id="iso9001_clause_5_1_2" model="iso9001.clause">
