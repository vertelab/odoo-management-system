<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ISO 9001 Clauses Tree View -->
    <record id="view_iso9001_clause_tree" model="ir.ui.view">
        <field name="name">iso9001.clause.tree</field>
        <field name="model">iso9001.clause</field>
        <field name="arch" type="xml">
            <list>
                <field name="clause_number"/>
                <field name="name"/>
                <field name="parent_id" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- ISO 9001 Clauses Form View -->
    <record id="view_iso9001_clause_form" model="ir.ui.view">
        <field name="name">iso9001.clause.form</field>
        <field name="model">iso9001.clause</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="clause_number" string="Clause"/>
                        <h1>
                            <field name="clause_number" class="oe_inline"/> -
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <field name="parent_id"/>
                        <field name="sequence"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_iso9001_clause" model="ir.actions.act_window">
        <field name="name">ISO 9001 Klausuler</field>
        <field name="res_model">iso9001.clause</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
