<odoo>
    <!-- Dashboard search over the shared gap lines, filtered to ISO 9001.
         The gap line model lives in mgmtsystem_iso_base; this shell only
         narrows it to its own standard. -->
    <record id="view_iso9001_gap_line_search" model="ir.ui.view">
        <field name="name">mgmtsystem.iso.gap.line.search.iso9001</field>
        <field name="model">mgmtsystem.iso.gap.line</field>
        <field name="arch" type="xml">
            <search>
                <filter name="filter_iso9001" string="ISO 9001"
                        domain="[('gap_id.standard_id', '=', %(mgmtsystem_iso_base.iso_standard_9001)d)]"/>
                <filter name="group_maturity" string="Gruppera efter mognad"
                        domain="[]"
                        context="{'group_by': 'maturity_level'}"/>
                <filter name="group_status" string="Gruppera efter status"
                        domain="[]"
                        context="{'group_by': 'status'}"/>
                <filter name="open_items" string="Öppna punkter"
                        domain="[('status', '=', 'open')]"/>
            </search>
        </field>
    </record>

    <!-- Dashboard: gap analysis pivot for ISO 9001 -->
    <record id="action_iso9001_dashboard" model="ir.actions.act_window">
        <field name="name">ISO 9001 Dashboard</field>
        <field name="res_model">mgmtsystem.iso.gap.line</field>
        <field name="view_mode">pivot,graph</field>
        <field name="search_view_id" ref="view_iso9001_gap_line_search"/>
        <field name="context">{'search_default_filter_iso9001': 1, 'search_default_group_maturity': 1}</field>
    </record>
</odoo>
