<odoo>
    <!-- ISO 9001 shell menu: only what is unique to the 9001 shell.
         Clauses and gap analyses live in the shared core menu
         (ISO Ledningssystem); policy in the manual module and
         objectives in the objective module. -->
    <menuitem id="menu_iso9001_root"
              name="Kvalitet (ISO 9001)"
              sequence="40"
              groups="group_iso9001_user"/>

    <menuitem id="menu_iso9001_processes"
              name="Processer"
              parent="menu_iso9001_root"
              action="action_iso9001_process"
              sequence="10"/>

    <menuitem id="menu_iso9001_dashboard"
              name="Dashboard"
              parent="menu_iso9001_root"
              action="action_iso9001_dashboard"
              sequence="50"/>
</odoo>
