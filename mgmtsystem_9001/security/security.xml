<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ISO 9001 Group Category -->
    <record id="module_category_iso9001" model="ir.module.category">
        <field name="name">ISO 9001 (QMS)</field>
        <field name="description">Kvalitetsledningssystem — moduler för ISO 9001:2026</field>
        <field name="sequence">90</field>
    </record>

    <!-- ISO 9001 Groups -->
    <record id="group_iso9001_user" model="res.groups">
        <field name="name">ISO 9001 User</field>
        <field name="category_id" ref="module_category_iso9001"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Kan läsa QMS-dokument, gap-analyser, mål och processer.</field>
    </record>

    <record id="group_iso9001_manager" model="res.groups">
        <field name="name">ISO 9001 Manager</field>
        <field name="category_id" ref="module_category_iso9001"/>
        <field name="implied_ids" eval="[(4, ref('group_iso9001_user'))]"/>
        <field name="comment">Kan skapa och redigera gap-analyser, policy, mål och processer.</field>
    </record>

    <record id="group_iso9001_officer" model="res.groups">
        <field name="name">ISO 9001 Officer</field>
        <field name="category_id" ref="module_category_iso9001"/>
        <field name="implied_ids" eval="[(4, ref('group_iso9001_manager'))]"/>
        <field name="comment">Fullständig administration av QMS-systemet.</field>
    </record>

    <!-- Record Rules: Company Isolation -->
    <record id="rule_iso9001_clause_company" model="ir.rule">
        <field name="name">ISO 9001 Clause: Company Isolation</field>
        <field name="model_id" ref="model_iso9001_clause"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_iso9001_policy_company" model="ir.rule">
        <field name="name">ISO 9001 Policy: Company Isolation</field>
        <field name="model_id" ref="model_iso9001_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_iso9001_gap_company" model="ir.rule">
        <field name="name">ISO 9001 Gap: Company Isolation</field>
        <field name="model_id" ref="model_iso9001_gap"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_iso9001_gap_line_company" model="ir.rule">
        <field name="name">ISO 9001 Gap Line: Company Isolation</field>
        <field name="model_id" ref="model_iso9001_gap_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_iso9001_objective_company" model="ir.rule">
        <field name="name">ISO 9001 Objective: Company Isolation</field>
        <field name="model_id" ref="model_iso9001_objective"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>

    <record id="rule_iso9001_process_company" model="ir.rule">
        <field name="name">ISO 9001 Process: Company Isolation</field>
        <field name="model_id" ref="model_iso9001_process"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
