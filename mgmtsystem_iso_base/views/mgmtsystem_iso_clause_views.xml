<odoo>
    <!-- ISO Clause List View -->
    <record id="view_mgmtsystem_iso_clause_list" model="ir.ui.view">
        <field name="name">mgmtsystem.iso.clause.list</field>
        <field name="model">mgmtsystem.iso.clause</field>
        <field name="arch" type="xml">
            <list default_order="standard_id, sequence, clause_number">
                <field name="clause_number"/>
                <field name="name"/>
                <field name="standard_id"/>
                <field name="parent_id" invisible="1"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <!-- ISO Clause Form View -->
    <record id="view_mgmtsystem_iso_clause_form" model="ir.ui.view">
        <field name="name">mgmtsystem.iso.clause.form</field>
        <field name="model">mgmtsystem.iso.clause</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <label for="clause_number" string="Klausul"/>
                        <h1>
                            <field name="clause_number" class="oe_inline"/> –
                            <field name="name" class="oe_inline"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="standard_id"/>
                            <field name="parent_id"
                                   domain="[('standard_id', '=', standard_id), ('id', '!=', id)]"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Beskrivning">
                        <field name="description" nolabel="1"/>
                    </group>
                    <group string="Underklausuler">
                        <field name="child_ids" nolabel="1">
                            <list>
                                <field name="clause_number"/>
                                <field name="name"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ISO Clause Search View -->
    <record id="view_mgmtsystem_iso_clause_search" model="ir.ui.view">
        <field name="name">mgmtsystem.iso.clause.search</field>
        <field name="model">mgmtsystem.iso.clause</field>
        <field name="arch" type="xml">
            <search>
                <field name="clause_number"/>
                <field name="name"/>
                <field name="standard_id"/>
                <filter name="filter_standard" string="Standard"
                        domain="[]" context="{'group_by': 'standard_id'}"/>
                <group expand="0" string="Gruppera efter">
                    <filter name="group_standard" string="Standard"
                            context="{'group_by': 'standard_id'}"/>
                    <filter name="group_company" string="Företag"
                            context="{'group_by': 'company_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_mgmtsystem_iso_clause" model="ir.actions.act_window">
        <field name="name">Klausuler</field>
        <field name="res_model">mgmtsystem.iso.clause</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
