"                                                                        <img style=\"margin-bottom:5px;width:50px;height:50px;border-radius:50%;object-fit:cover;\" t-att-src=\"image_data_uri(object.env['res.users']."
"browse(goal['user_id']).partner_id.image_128)\" t-att-alt=\"goal['name']\"/>\n"
