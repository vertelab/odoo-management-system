<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="slide_channel_9001" model="slide.channel">
        <field name="name">ISO 9001:2026 — Kvalitetsledning (Grundkurs)</field>
        <field name="description">Grundläggande utbildning i ISO 9001:2026. Omfattar: kvalitetsprinciper, processynsätt, PDCA-cykeln, ledarskap, riskbaserat tänkande och ständig förbättring.</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="slide_channel_14001" model="slide.channel">
        <field name="name">ISO 14001:2026 — Miljöledning (Grundkurs)</field>
        <field name="description">Grundläggande utbildning i ISO 14001:2026. Omfattar: miljöpolicy, miljöaspekter, livscykelperspektiv, lagkrav och ständig förbättring.</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="slide_channel_27001" model="slide.channel">
        <field name="name">ISO 27001:2022 — Informationssäkerhet (Grundkurs)</field>
        <field name="description">Grundläggande utbildning i ISO 27001:2022. Omfattar: informationssäkerhetspolicy, riskbedömning, Annex A-kontroller, incidenthantering och ständig förbättring.</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="slide_channel_22000" model="slide.channel">
        <field name="name">ISO 22000:2018 — Livsmedelssäkerhet (Grundkurs)</field>
        <field name="description">Grundläggande utbildning i ISO 22000:2018. Omfattar: PRP, HACCP, CCP, faroanalys, spårbarhet och nödberedskap.</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="is_published" eval="True"/>
    </record>
    <record id="slide_channel_sam" model="slide.channel">
        <field name="name">SAM — Systematiskt Arbetsmiljöarbete (Grundkurs)</field>
        <field name="description">Grundläggande utbildning i systematiskt arbetsmiljöarbete (ISO 45001/AFS 2023:1). Omfattar: policy, riskbedömning, skyddsronder, tillbud och årlig uppföljning.</field>
        <field name="channel_type">training</field>
        <field name="enroll">public</field>
        <field name="is_published" eval="True"/>
    </record>
</odoo>
