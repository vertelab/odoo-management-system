<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="ai_canvas_capability_view_form" model="ir.ui.view">
            <field name="name">ai.canvas.capability.view.form</field>
            <field name="model">ai.canvas.capability</field>
            <field name="arch" type="xml">
                <form string="AI Canvas Capability">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Capability"/>
                            <h1><field name="name" placeholder="e.g. Språk"/></h1>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="ai_canvas_capability_view_list" model="ir.ui.view">
            <field name="name">ai.canvas.capability.view.list</field>
            <field name="model">ai.canvas.capability</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="ai_canvas_capability_action" model="ir.actions.act_window">
            <field name="name">AI Canvas Capability</field>
            <field name="res_model">ai.canvas.capability</field>
            <field name="view_mode">list,form</field>
            <field name="view_id" ref="project_task_aicanvas.ai_canvas_capability_view_list"/>
        </record>

        <menuitem name="AI Canvas Capability" id="ai_canvas_capability_action_menu" parent="project.menu_project_config" action="project_task_aicanvas.ai_canvas_capability_action"/>


    </data>
</odoo>