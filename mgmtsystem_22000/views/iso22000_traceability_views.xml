<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso22000_traceability_tree" model="ir.ui.view">
        <field name="name">iso22000.traceability.tree</field>
        <field name="model">iso22000.traceability</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="product_id"/><field name="batch_id"/><field name="test_date"/><field name="result"/><field name="time_to_trace"/></list>
        </field>
    </record>
    <record id="view_iso22000_traceability_form" model="ir.ui.view">
        <field name="name">iso22000.traceability.form</field>
        <field name="model">iso22000.traceability</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Traceability Test Name"/></h1></div>
                    <group>
                        <field name="product_id"/>
                        <field name="batch_id"/>
                        <field name="direction"/>
                        <field name="test_date"/>
                        <field name="tested_by"/>
                    </group>
                    <group>
                        <field name="start_time"/>
                        <field name="end_time"/>
                        <field name="time_to_trace"/>
                        <field name="result"/>
                        <field name="percentage_traced"/>
                    </group>
                    <group string="Issues Found"><field name="issues_found" nolabel="1"/></group>
                    <group string="Corrective Actions"><field name="corrective_actions" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iso22000_traceability" model="ir.actions.act_window">
        <field name="name">Spårbarhetstest</field>
        <field name="res_model">iso22000.traceability</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
