<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso22000_policy_tree" model="ir.ui.view">
        <field name="name">iso22000.policy.tree</field>
        <field name="model">iso22000.policy</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="date_approved"/>
                <field name="date_review"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_iso22000_policy_form" model="ir.ui.view">
        <field name="name">iso22000.policy.form</field>
        <field name="model">iso22000.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object"
                            invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_archive" string="Archive" type="object"
                            invisible="state != 'active'"/>
                    <button name="action_draft" string="Reset to Draft" type="object"
                            invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Policy Name"/></h1>
                    </div>
                    <group>
                        <field name="date_approved"/>
                        <field name="date_review"/>
                        <field name="approved_by"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="ISO 22000">
                        <field name="iso22000_clause_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Policy">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_iso22000_policy" model="ir.actions.act_window">
        <field name="name">Livsmedelssäkerhetspolicy</field>
        <field name="res_model">iso22000.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
