<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso22000_emergency_tree" model="ir.ui.view">
        <field name="name">iso22000.emergency.tree</field>
        <field name="model">iso22000.emergency</field>
        <field name="arch" type="xml">
            <list><field name="name"/><field name="scenario"/><field name="last_tested"/><field name="next_test_date"/><field name="state"/></list>
        </field>
    </record>
    <record id="view_iso22000_emergency_form" model="ir.ui.view">
        <field name="name">iso22000.emergency.form</field>
        <field name="model">iso22000.emergency</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_activate" string="Activate" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_test_complete" string="Test Complete" type="object" invisible="state != 'active'" class="btn-primary"/>
                    <button name="action_needs_review" string="Needs Review" type="object" invisible="state not in ('active', 'tested')"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,tested,outdated"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Emergency Plan Name"/></h1></div>
                    <group>
                        <field name="scenario"/>
                        <field name="test_frequency"/>
                        <field name="last_tested"/>
                        <field name="next_test_date"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Emergency Response Team"><field name="responsible_ids" widget="many2many_tags"/></group>
                    <group string="Scenario Description"><field name="description" nolabel="1"/></group>
                    <group string="Emergency Procedure"><field name="procedure" nolabel="1"/></group>
                    <group string="External Contacts"><field name="external_contacts" nolabel="1"/></group>
                    <group string="Communication Template"><field name="communication_template" nolabel="1"/></group>
                    <group string="Last Test Result"><field name="test_result" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iso22000_emergency" model="ir.actions.act_window">
        <field name="name">Nödberedskap / Recall</field>
        <field name="res_model">iso22000.emergency</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
