<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ISO 27001 Top Menu -->
    <menuitem id="menu_iso27001_root"
              name="ISO 27001"
              parent="mgmtsystem.menu_mgmtsystem_root"
              sequence="15"
              groups="group_iso27001_user"/>

    <!-- Gap Analysis -->
    <menuitem id="menu_iso27001_gap"
              name="Gap Analysis"
              parent="menu_iso27001_root"
              action="action_open_iso27001_gap"
              sequence="10"/>

    <!-- Annex A Controls -->
    <menuitem id="menu_iso27001_controls"
              name="Annex A Controls"
              parent="menu_iso27001_root"
              action="action_open_iso27001_controls"
              sequence="20"/>

    <!-- Statement of Applicability -->
    <menuitem id="menu_iso27001_soa"
              name="Statement of Applicability"
              parent="menu_iso27001_root"
              action="action_open_iso27001_soa"
              sequence="30"/>

    <!-- Policies -->
    <menuitem id="menu_iso27001_policy"
              name="Security Policies"
              parent="menu_iso27001_root"
              action="action_open_iso27001_policies"
              sequence="40"/>

    <!-- Clauses -->
    <menuitem id="menu_iso27001_clauses"
              name="ISO 27001:2022 Clauses"
              parent="menu_iso27001_root"
              action="action_open_iso27001_clauses"
              sequence="50"/>

    <!-- Dashboard -->
    <menuitem id="menu_iso27001_dashboard"
              name="Dashboard"
              parent="menu_iso27001_root"
              action="action_iso27001_dashboard"
              sequence="5"/>

    <!-- Configuration -->
    <menuitem id="menu_iso27001_config"
              name="Configuration"
              parent="menu_iso27001_root"
              groups="group_iso27001_manager"
              sequence="90"/>
</odoo>
