<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Form View: Policy ====== -->
    <record id="view_iso27001_policy_form" model="ir.ui.view">
        <field name="name">iso27001.policy.form</field>
        <field name="model">iso27001.policy</field>
        <field name="arch" type="xml">
            <form string="Information Security Policy">
                <header>
                    <button name="action_approve" string="Approve"
                            states="draft" type="object" class="btn-primary"/>
                    <button name="action_archive" string="Archive"
                            states="active" type="object"/>
                    <button name="action_draft" string="Reset to Draft"
                            states="active,archived" type="object"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="approved_by"/>
                            <field name="date_approved" attrs="{'invisible': [('state', '!=', 'active')]}"/>
                            <field name="date_review"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="iso27001_clause_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <group string="Policy Description">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ====== List View: Policy ====== -->
    <record id="view_iso27001_policy_list" model="ir.ui.view">
        <field name="name">iso27001.policy.list</field>
        <field name="model">iso27001.policy</field>
        <field name="arch" type="xml">
            <list string="Information Security Policies">
                <field name="name"/>
                <field name="approved_by"/>
                <field name="date_approved"/>
                <field name="date_review"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'active'"
                       decoration-warning="state == 'draft'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ====== Search View: Policy ====== -->
    <record id="view_iso27001_policy_search" model="ir.ui.view">
        <field name="name">iso27001.policy.search</field>
        <field name="model">iso27001.policy</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="approved_by"/>
                <separator/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_active" string="Active" domain="[('state', '=', 'active')]"/>
                <filter name="state_archived" string="Archived" domain="[('state', '=', 'archived')]"/>
            </search>
        </field>
    </record>

    <!-- ====== Action: Open Policies ====== -->
    <record id="action_open_iso27001_policies" model="ir.actions.act_window">
        <field name="name">Information Security Policies</field>
        <field name="res_model">iso27001.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
