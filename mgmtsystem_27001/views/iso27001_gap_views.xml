<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ====== Form View: Gap Analysis ====== -->
    <record id="view_iso27001_gap_form" model="ir.ui.view">
        <field name="name">iso27001.gap.form</field>
        <field name="model">iso27001.gap</field>
        <field name="arch" type="xml">
            <form string="Gap Analysis">
                <header>
                    <button name="action_start" string="Start Analysis"
                            states="draft" type="object" class="btn-primary"/>
                    <button name="action_complete" string="Complete"
                            states="in_progress" type="object" class="btn-primary"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="date"/>
                            <field name="assessed_by"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Control Assessment" name="controls">
                            <field name="line_ids" nolabel="1">
                                <list default_group_by="control_group" editable="bottom">
                                    <field name="control_id" string="Annex A Control"
                                           context="{'default_system_id': system_id}" required="1"/>
                                    <field name="maturity_level" widget="badge" decoration-bf="1"/>
                                    <field name="status" widget="badge"
                                           decoration-success="status == 'resolved'"
                                           decoration-warning="status == 'in_progress'"/>
                                    <field name="finding"/>
                                    <field name="recommendation"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- ====== List View: Gap Analysis ====== -->
    <record id="view_iso27001_gap_list" model="ir.ui.view">
        <field name="name">iso27001.gap.list</field>
        <field name="model">iso27001.gap</field>
        <field name="arch" type="xml">
            <list string="Gap Analyses">
                <field name="name"/>
                <field name="date"/>
                <field name="assessed_by"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'in_progress'"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <!-- ====== Search View: Gap Analysis ====== -->
    <record id="view_iso27001_gap_search" model="ir.ui.view">
        <field name="name">iso27001.gap.search</field>
        <field name="model">iso27001.gap</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="assessed_by"/>
                <separator/>
                <filter name="state_draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="state_in_progress" string="In Progress" domain="[('state', '=', 'in_progress')]"/>
                <filter name="state_done" string="Completed" domain="[('state', '=', 'done')]"/>
            </search>
        </field>
    </record>

    <!-- ====== Action: Open Gap Analyses ====== -->
    <record id="action_open_iso27001_gap" model="ir.actions.act_window">
        <field name="name">Gap Analyses</field>
        <field name="res_model">iso27001.gap</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
