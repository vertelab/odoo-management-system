<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>
        <record id="year_wheel_view_form_popup" model="ir.ui.view">
            <field name="name">year.wheel.view.form.popup</field>
            <field name="model">year.wheel.wizard</field>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <form string="Management Year Wheel" create="false">
                    <sheet>
                        <group>
                            <group>
                                <field name="res_model_id" />
                                <field name="res_model" />
                                <field name="res_id" />
                                <field name="activity_type_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="summary" placeholder="e.g. Discuss proposal"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="end_date"/>
                                <label for="interval"/>
                                <div class="o_col">
                                    <div class="o_row">
                                        <field name="interval" class="oe_inline"/>
                                        <field name="time_unit"/>
                                    </div>
                                </div>
                                <field name="user_id"/>
                            </group>
                        </group>
                        <field name="note" class="oe-bordered-editor" placeholder="Log a note..."/>
                        <footer>
                            <field name="id" invisible="1"/>
                            <button id="year_wheel" string="Create Wheel" name="action_create_year_wheel" type="object" class="btn-primary"/>

                            <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="z" />
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>


        <record id="mgmtsystem_year_wheel_popup_action" model="ir.actions.server">
            <field name="name">Create Year Wheel</field>
            <field name="model_id" ref="mgmtsystem_yearwheel.model_year_wheel_wizard"/>
            <field name="binding_model_id" ref="mgmtsystem_yearwheel.model_year_wheel_wizard"/>
            <field name="binding_view_types">form</field>
            <field name="state">code</field>
            <field name="code">action = model.action_open_wheel_wizard()</field>
        </record>

    </data>
</odoo>