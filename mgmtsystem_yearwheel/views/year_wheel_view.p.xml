<odoo>
    <data>
        <record id="year_wheel_view_form" model="ir.ui.view">
            <field name="name">year.wheel.view.form</field>
            <field name="model">year.wheel</field>
            <field name="arch" type="xml">
                <form string="Management Year Wheel">
                    <sheet>
                        <div name="button_box" class="oe_button_box">
                            <button name="action_view_activities" class="oe_stat_button" icon="fa-tasks" type="object">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_value"><field name="activity_count"/></span>
                                    <span class="o_stat_text">Activities</span>
                                </div>
                            </button>
                        </div>

                        <group>
                            <group>
                                <field name="resource_ref"/>
                                <field name="res_model_id" invisible="1"/>
                                <field name="res_model" invisible="1"/>

                                <field name="res_id" invisible="1"/>
                                <field name="activity_type_id" required="1" options="{'no_create': True, 'no_open': True}"/>
                                <field name="summary" placeholder="e.g. Discuss proposal" required="1"/>
                            </group>
                            <group>
                                <field name="start_date"/>
                                <field name="next_activity_date"/>
                                <field name="end_date"/>

                                <label for="interval"/>
                                <div class="o_col">
                                    <div class="o_row">
                                        <field name="interval" class="oe_inline"/>
                                        <field name="time_unit"/>
                                    </div>
                                </div>

                                <field name="user_id"/>
                            </group>
                        </group>
                        <field name="note" class="oe-bordered-editor" placeholder="Log a note..."/>
                        <footer>
                            <field name="id" invisible="1"/>
                            <!-- #if VERSION >= "17.0" -->
                            <button id="year_wheel_activity" string="Schedule" name="action_create_year_wheel_activity" type="object" class="btn-primary" invisible="id" data-hotkey="q"/>
                            <!-- #elif VERSION < "17.0" -->
                            <button id="year_wheel_activity" string="Schedule" name="action_create_year_wheel_activity" type="object" class="btn-primary"
                                attrs="{'invisible': [('id', '!=', False)]}" data-hotkey="q"/>
                            <!-- #endif -->
                            <button string="Discard" class="btn-secondary" special="cancel" data-hotkey="z"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="year_wheel_view_tree" model="ir.ui.view">
            <field name="name">year.wheel.view.tree</field>
            <field name="model">year.wheel</field>
            <field name="arch" type="xml">
            <!-- #if VERSION >= "18.0" -->
                <list>
                    <field name="summary"/>
                    <field name="resource_ref" options="{'model_field': 'res_model_id', 'no_create': True}" invisible="not resource_ref"/>
                    <field name="res_model" optional="hide"/>
                    <field name="res_model_id" invisible="1"/>
                     <field name="next_activity_date"/>
                     <field name="activity_type_id"/>
                     <field name="interval"/>
                     <field name="time_unit"/>
                    <field name="start_date" optional="hide"/>
                    <field name="end_date" optional="hide"/>
                    <field name="user_id"/>
                </list>
            <!-- #elif VERSION < "18.0" -->
                <tree>
                    <field name="summary"/>
                    <!-- #if VERSION == "17.0" -->
                    <field name="resource_ref" options="{'model_field': 'res_model_id', 'no_create': True}" invisible="not resource_ref"/>
                    <!-- #elif VERSION < "17.0" -->
                    <field name="resource_ref" options="{'model_field': 'res_model_id', 'no_create': True}" attrs="{'invisible': [('resource_ref', '=', False)]}" />
                    <!-- #endif -->
                    <field name="res_model" optional="hide"/>
                    <field name="res_model_id" invisible="1"/>
                    <field name="next_activity_date"/>
                    <field name="activity_type_id"/>
                    <field name="interval"/>
                    <field name="time_unit"/>
                    <field name="start_date" optional="hide"/>
                    <field name="end_date" optional="hide"/>
                    <field name="user_id"/>
                </tree>
            <!-- #endif -->
            </field>
        </record>

        <record id="mgmtsystem_year_wheel_action" model="ir.actions.act_window">
            <field name="name">Management Year Wheel</field>
            <field name="res_model">year.wheel</field>
            <!-- #if VERSION >= "18.0" -->
            <field name="view_mode">list,form</field>
            <!-- #elif VERSION < "18.0" -->
            <field name="view_mode">tree,form</field>
            <!-- #endif -->
            <field name="view_id" ref="mgmtsystem_yearwheel.year_wheel_view_tree"/>
        </record>

    </data>
</odoo>

