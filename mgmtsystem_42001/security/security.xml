        <field name="global" eval="True"/>
    </record>
    <record id="rule_iso42001_impact_assessment_company" model="ir.rule">
        <field name="name">ISO 42001 Impact Assessment: Company Isolation</field>
        <field name="model_id" ref="model_iso42001_impact_assessment"/>
