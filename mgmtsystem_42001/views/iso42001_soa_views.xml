<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso42001_soa_tree" model="ir.ui.view">
        <field name="name">iso42001.soa.tree</field>
        <field name="model">iso42001.soa</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="date"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_iso42001_soa_form" model="ir.ui.view">
        <field name="name">iso42001.soa.form</field>
        <field name="model">iso42001.soa</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_archive" string="Archive" type="object" invisible="state != 'approved'"/>
                    <button name="action_draft" string="Reset" type="object" invisible="state != 'archived'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,archived"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="date"/><field name="approved_by"/><field name="date_approved"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="Notes"><field name="notes" nolabel="1"/></group>
                    <group string="Statement of Applicability Lines">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="control_id"/>
                                <field name="applicable"/>
                                <field name="implemented"/>
                                <field name="justification"/>
                                <field name="implementation_status"/>
                            </list>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iso42001_soa" model="ir.actions.act_window">
        <field name="name">Statement of Applicability</field>
        <field name="res_model">iso42001.soa</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
