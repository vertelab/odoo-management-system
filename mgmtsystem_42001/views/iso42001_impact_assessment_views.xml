<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso42001_impact_tree" model="ir.ui.view">
        <field name="name">iso42001.impact.assessment.tree</field>
        <field name="model">iso42001.impact.assessment</field>
        <field name="arch" type="xml">
            <list>
                <field name="aisystem_id"/><field name="date_assessed"/>
                <field name="assessed_by"/><field name="state"/>
            </list>
        </field>
    </record>
    <record id="view_iso42001_impact_form" model="ir.ui.view">
        <field name="name">iso42001.impact.assessment.form</field>
        <field name="model">iso42001.impact.assessment</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" string="Submit for Review" type="object" invisible="state != 'draft'" class="btn-primary"/>
                    <button name="action_approve" string="Approve" type="object" invisible="state != 'in_review'" class="btn-primary"/>
                    <button name="action_reject" string="Reject" type="object" invisible="state != 'in_review'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_review,approved,rejected"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="aisystem_id"/><field name="date_assessed"/>
                            <field name="assessed_by"/>
                        </group>
                    </group>
                    <group string="Impact Assessment Scores (1=worst, 5=best)" colspan="4">
                        <group>
                            <field name="fairness"/><field name="transparency"/>
                            <field name="privacy"/><field name="safety"/>
                        </group>
                    </group>
                    <group string="Governance">
                        <field name="human_oversight"/>
                    </group>
                    <group string="Mitigation and Impact">
                        <field name="bias_mitigation"/>
                        <field name="environmental_impact"/>
                        <field name="societal_impact"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iso42001_impact" model="ir.actions.act_window">
        <field name="name">AI Impact Assessments</field>
        <field name="res_model">iso42001.impact.assessment</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
