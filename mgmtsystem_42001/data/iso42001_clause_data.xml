            <field name="sequence">30</field>
        </record>
        <record id="iso42001_clause_6_1" model="iso42001.clause">
            <field name="name">Åtgärder för att hantera risker och möjligheter</field>
            <field name="clause_number">6.1</field>
            <field name="parent_id" ref="iso42001_clause_6"/>
            <field name="sequence">31</field>
        </record>
        <record id="iso42001_clause_6_1_2" model="iso42001.clause">
            <field name="name">AI-riskbedömning</field>
            <field name="clause_number">6.1.2</field>
            <field name="parent_id" ref="iso42001_clause_6_1"/>
            <field name="description">Organisationen ska identifiera och bedöma AI-relaterade risker, inklusive bias, diskriminering, integritet, säkerhet och transparens. Riskkällor enligt Annex C ska beaktas.</field>
            <field name="sequence">32</field>
        </record>
        <record id="iso42001_clause_6_1_4" model="iso42001.clause">
            <field name="name">AI-konsekvensbedömning</field>
            <field name="clause_number">6.1.4</field>
            <field name="parent_id" ref="iso42001_clause_6_1"/>
            <field name="description">Organisationen ska bedöma potentiella konsekvenser av AI-system på individer och samhälle, inklusive fairness, transparens, integritet, säkerhet och mänsklig översyn.</field>
            <field name="sequence">33</field>
        </record>
        <record id="iso42001_clause_6_2" model="iso42001.clause">
            <field name="name">AI-mål och planering för att uppnå dem</field>
            <field name="clause_number">6.2</field>
            <field name="parent_id" ref="iso42001_clause_6"/>
            <field name="description">AI-mål ska vara mätbara och överensstämma med AI-policyn. Annex C ger exempel på organisationsspecifika AI-mål.</field>
            <field name="sequence">34</field>
        </record>

