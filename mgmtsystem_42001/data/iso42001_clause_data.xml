        <record id="iso42001_clause_5_2" model="iso42001.clause">
            <field name="name">AI-policy</field>
            <field name="clause_number">5.2</field>
            <field name="parent_id" ref="iso42001_clause_5"/>
            <field name="description">Högsta ledningen ska upprätta en AI-policy som är lämplig för organisationens syfte och inkluderar åtaganden om ansvarsfull AI-användning, etiska principer, regelefterlevnad och ständig förbättring.</field>
