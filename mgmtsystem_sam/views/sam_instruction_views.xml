<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Instruction Tree -->
    <record id="view_sam_instruction_tree" model="ir.ui.view">
        <field name="name">sam.instruction.tree</field>
        <field name="model">sam.instruction</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="department_id"/>
                <field name="revision_date"/>
            </tree>
        </field>
    </record>

    <!-- Instruction Form -->
    <record id="view_sam_instruction_form" model="ir.ui.view">
        <field name="name">sam.instruction.form</field>
        <field name="model">sam.instruction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Instruktionens namn"/></h1>
                    </div>
                    <group>
                        <field name="department_id"/>
                        <field name="revision_date"/>
                    </group>
                    <group string="ISO 45001">
                        <field name="iso_clause_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Arbetsmoment">
                        <field name="task_description" nolabel="1"/>
                    </group>
                    <group string="Risker">
                        <field name="risk_description" nolabel="1"/>
                    </group>
                    <group string="Skyddsåtgärder">
                        <field name="safety_measures" nolabel="1"/>
                    </group>
                    <group string="Skyddsutrustning">
                        <field name="ppe_required" nolabel="1"/>
                    </group>
                    <group string="Nödprocedur">
                        <field name="emergency_procedure" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Instruction Action -->
    <record id="action_sam_instruction" model="ir.actions.act_window">
        <field name="name">Arbets- och skyddsinstruktioner</field>
        <field name="res_model">sam.instruction</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
