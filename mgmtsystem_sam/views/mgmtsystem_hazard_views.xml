<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend mgmtsystem.hazard form -->
    <record id="view_mgmtsystem_hazard_form_sam" model="ir.ui.view">
        <field name="name">mgmtsystem.hazard.form.sam</field>
        <field name="model">mgmtsystem.hazard</field>
        <field name="inherit_id" ref="mgmtsystem_hazard.view_mgmtsystem_hazard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SAM / ISO 45001">
                    <field name="risk_category"/>
                    <field name="assessed_by" widget="many2many_tags"/>
                    <field name="iso_clause_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
