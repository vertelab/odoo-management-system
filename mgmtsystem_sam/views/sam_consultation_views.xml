<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Consultation Tree -->
    <record id="view_sam_consultation_tree" model="ir.ui.view">
        <field name="name">sam.consultation.tree</field>
        <field name="model">sam.consultation</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="department_id"/>
                <field name="date_consultation"/>
            </tree>
        </field>
    </record>

    <!-- Consultation Form -->
    <record id="view_sam_consultation_form" model="ir.ui.view">
        <field name="name">sam.consultation.form</field>
        <field name="model">sam.consultation</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Samrådets namn"/></h1>
                    </div>
                    <group>
                        <field name="department_id"/>
                        <field name="date_consultation"/>
                        <field name="discuss_channel_id"
                               attrs="{'invisible': [('discuss_channel_id', '=', False)]}"/>
                    </group>
                    <group string="ISO 45001">
                        <field name="iso_clause_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Deltagare">
                        <field name="participant_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Ämne">
                        <field name="topic" nolabel="1"/>
                    </group>
                    <group string="Slutsats">
                        <field name="conclusion" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Consultation Action -->
    <record id="action_sam_consultation" model="ir.actions.act_window">
        <field name="name">Medverkan / Samråd</field>
        <field name="res_model">sam.consultation</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
