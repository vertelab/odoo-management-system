<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Policy Tree -->
    <record id="view_sam_policy_tree" model="ir.ui.view">
        <field name="name">sam.policy.tree</field>
        <field name="model">sam.policy</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="date_approved"/>
                <field name="date_review"/>
                <field name="state"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <!-- Policy Form -->
    <record id="view_sam_policy_form" model="ir.ui.view">
        <field name="name">sam.policy.form</field>
        <field name="model">sam.policy</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_approve" string="Godkänn" type="object"
                            states="draft" class="oe_highlight"/>
                    <button name="action_archive" string="Arkivera" type="object"
                            states="active"/>
                    <button name="action_draft" string="Återställ utkast" type="object"
                            states="archived"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Policynamn"/></h1>
                    </div>
                    <group>
                        <field name="date_approved"/>
                        <field name="date_review"/>
                        <field name="approved_by"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                    <group string="ISO 45001">
                        <field name="iso_clause_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Policy">
                        <field name="description" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Policy Action -->
    <record id="action_sam_policy" model="ir.actions.act_window">
        <field name="name">Arbetsmiljöpolicy</field>
        <field name="res_model">sam.policy</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
