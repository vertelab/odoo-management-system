<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend mgmtsystem.nonconformity form -->
    <record id="view_mgmtsystem_nonconformity_form_sam" model="ir.ui.view">
        <field name="name">mgmtsystem.nonconformity.form.sam</field>
        <field name="model">mgmtsystem.nonconformity</field>
        <field name="inherit_id" ref="mgmtsystem_nonconformity.view_mgmtsystem_nonconformity_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SAM / Tillbudsinformation">
                    <field name="incident_type"/>
                    <field name="reported_by_employee_id"/>
                    <field name="iso_clause_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Extend tree view -->
    <record id="view_mgmtsystem_nonconformity_tree_sam" model="ir.ui.view">
        <field name="name">mgmtsystem.nonconformity.tree.sam</field>
        <field name="model">mgmtsystem.nonconformity</field>
        <field name="inherit_id" ref="mgmtsystem_nonconformity.view_mgmtsystem_nonconformity_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="inside">
                <field name="incident_type"/>
            </xpath>
        </field>
    </record>
</odoo>
