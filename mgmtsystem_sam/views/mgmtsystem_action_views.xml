<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend mgmtsystem.action form -->
    <record id="view_mgmtsystem_action_form_sam" model="ir.ui.view">
        <field name="name">mgmtsystem.action.form.sam</field>
        <field name="model">mgmtsystem.action</field>
        <field name="inherit_id" ref="mgmtsystem_action.view_mgmtsystem_action_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="SAM / ISO 45001">
                    <field name="hazard_id"/>
                    <field name="verification_result"/>
                    <field name="iso_clause_ids" widget="many2many_tags"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
