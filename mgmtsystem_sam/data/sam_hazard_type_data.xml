<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Swedish hazard types for mgmtsystem.hazard.type -->
        <record id="hazard_type_physical" model="mgmtsystem.hazard.type">
            <field name="name">Fysisk</field>
            <field name="description">Fysiska risker såsom buller, vibrationer, strålning, temperatur, fallrisker, maskiner</field>
        </record>
        <record id="hazard_type_psychosocial" model="mgmtsystem.hazard.type">
            <field name="name">Psykosocial</field>
            <field name="description">Psykosociala risker såsom stress, hög arbetsbelastning, kränkande särbehandling, konflikter</field>
        </record>
        <record id="hazard_type_chemical" model="mgmtsystem.hazard.type">
            <field name="name">Kemisk</field>
            <field name="description">Kemiska risker såsom farliga ämnen, gaser, damm, asbest, lösningsmedel</field>
        </record>
        <record id="hazard_type_biological" model="mgmtsystem.hazard.type">
            <field name="name">Biologisk</field>
            <field name="description">Biologiska risker såsom smittämnen, bakterier, virus, mögel, parasiter</field>
        </record>
        <record id="hazard_type_ergonomic" model="mgmtsystem.hazard.type">
            <field name="name">Ergonomisk</field>
            <field name="description">Ergonomiska risker såsom tunga lyft, ensidigt arbete, dålig arbetsställning, repetitivt arbete</field>
        </record>
    </data>
</odoo>
