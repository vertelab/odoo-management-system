<odoo>
    <!-- Kontrollens form: knapp för att skapa/öppna avvikelse + bakåtlänk.
         Knappen erbjuds bara för en underkänd kontroll (task 3.5). -->
    <record id="quality_check_view_form_nc" model="ir.ui.view">
        <field name="name">quality.check.view.form.nc</field>
        <field name="model">quality.check</field>
        <field name="inherit_id" ref="quality_control_ce.quality_check_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='do_alert']" position="after">
                <button name="action_create_nonconformity"
                        type="object"
                        string="Skapa avvikelse"
                        class="btn-primary"
                        invisible="quality_state != 'fail' or nonconformity_id"/>
                <button name="action_view_nonconformity"
                        type="object"
                        string="Visa avvikelse"
                        invisible="not nonconformity_id"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_nonconformity"
                        icon="fa-exclamation-triangle"
                        type="object"
                        class="oe_stat_button"
                        invisible="not nonconformity_id">
                    <field name="nonconformity_count" string="Avvikelser" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//field[@name='company_id'][@invisible='1']" position="after">
                <field name="nonconformity_id" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
