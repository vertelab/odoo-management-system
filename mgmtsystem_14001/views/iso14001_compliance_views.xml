<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_iso14001_compliance_tree" model="ir.ui.view">
        <field name="name">iso14001.compliance.tree</field>
        <field name="model">iso14001.compliance</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/><field name="source"/><field name="deadline"/>
                <field name="status"/><field name="responsible_id"/>
            </list>
        </field>
    </record>
    <record id="view_iso14001_compliance_form" model="ir.ui.view">
        <field name="name">iso14001.compliance.form</field>
        <field name="model">iso14001.compliance</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_mark_compliant" string="Mark Compliant" type="object" invisible="status == 'compliant'" class="btn-primary"/>
                    <button name="action_mark_noncompliant" string="Mark Non-Compliant" type="object" invisible="status == 'non_compliant'"/>
                    <field name="status" widget="statusbar" statusbar_visible="to_evaluate,compliant,non_compliant"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="source"/><field name="reference"/>
                            <field name="deadline"/><field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Requirement"><field name="requirement_text" nolabel="1"/></group>
                    <group string="ISO 14001"><field name="iso14001_clause_ids" widget="many2many_tags"/></group>
                    <group string="Evidence"><field name="evidence" nolabel="1"/></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_iso14001_compliance" model="ir.actions.act_window">
        <field name="name">Compliance Obligations</field>
        <field name="res_model">iso14001.compliance</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
