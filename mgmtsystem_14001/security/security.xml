<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_iso14001" model="ir.module.category">
        <field name="name">ISO 14001 (EMS)</field>
        <field name="description">Miljöledningssystem — moduler för ISO 14001:2026</field>
        <field name="sequence">92</field>
    </record>

    <record id="group_iso14001_user" model="res.groups">
        <field name="name">ISO 14001 User</field>
        <field name="category_id" ref="module_category_iso14001"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        <field name="comment">Kan läsa EMS-dokument, gap-analyser, miljöaspekter och lagkrav.</field>
    </record>

    <record id="group_iso14001_manager" model="res.groups">
        <field name="name">ISO 14001 Manager</field>
        <field name="category_id" ref="module_category_iso14001"/>
        <field name="implied_ids" eval="[(4, ref('group_iso14001_user'))]"/>
        <field name="comment">Kan skapa och redigera gap-analyser, policy, aspekter och lagkrav.</field>
    </record>

    <record id="group_iso14001_officer" model="res.groups">
        <field name="name">ISO 14001 Officer</field>
        <field name="category_id" ref="module_category_iso14001"/>
        <field name="implied_ids" eval="[(4, ref('group_iso14001_manager'))]"/>
        <field name="comment">Fullständig administration av EMS-systemet.</field>
    </record>

    <record id="rule_iso14001_clause_company" model="ir.rule">
        <field name="name">ISO 14001 Clause: Company Isolation</field>
        <field name="model_id" ref="model_iso14001_clause"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_iso14001_policy_company" model="ir.rule">
        <field name="name">ISO 14001 Policy: Company Isolation</field>
        <field name="model_id" ref="model_iso14001_policy"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_iso14001_gap_company" model="ir.rule">
        <field name="name">ISO 14001 Gap: Company Isolation</field>
        <field name="model_id" ref="model_iso14001_gap"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_iso14001_gap_line_company" model="ir.rule">
        <field name="name">ISO 14001 Gap Line: Company Isolation</field>
        <field name="model_id" ref="model_iso14001_gap_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_iso14001_aspect_company" model="ir.rule">
        <field name="name">ISO 14001 Aspect: Company Isolation</field>
        <field name="model_id" ref="model_iso14001_aspect"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_iso14001_compliance_company" model="ir.rule">
        <field name="name">ISO 14001 Compliance: Company Isolation</field>
        <field name="model_id" ref="model_iso14001_compliance"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
    <record id="rule_iso14001_objective_company" model="ir.rule">
        <field name="name">ISO 14001 Objective: Company Isolation</field>
        <field name="model_id" ref="model_iso14001_objective"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="global" eval="True"/>
    </record>
</odoo>
