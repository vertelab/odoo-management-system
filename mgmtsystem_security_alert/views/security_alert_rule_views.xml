<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_alert_rule_tree" model="ir.ui.view">
        <field name="name">security.alert.rule.tree</field>
        <field name="model">security.alert.rule</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="rule_type"/>
                <field name="value"/>
                <field name="action"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_security_alert_rule_form" model="ir.ui.view">
        <field name="name">security.alert.rule.form</field>
        <field name="model">security.alert.rule</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="source_id"/>
                        <field name="rule_type"/>
                        <field name="value"/>
                        <field name="action"/>
                        <field name="active"/>
                        <field name="sequence"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_security_alert_rule" model="ir.actions.act_window">
        <field name="name">Alert Rules</field>
        <field name="res_model">security.alert.rule</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
