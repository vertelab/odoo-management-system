<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_alert_source_tree" model="ir.ui.view">
        <field name="name">security.alert.source.tree</field>
        <field name="model">security.alert.source</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="source_type"/>
                <field name="active"/>
                <field name="last_fetch"/>
                <field name="alert_count"/>
            </list>
        </field>
    </record>
    <record id="view_security_alert_source_form" model="ir.ui.view">
        <field name="name">security.alert.source.form</field>
        <field name="model">security.alert.source</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_fetch_now" string="Fetch Now" type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <field name="source_type"/>
                        <field name="url" widget="url"/>
                        <field name="api_key" attrs="{'invisible': [('source_type', '!=', 'nvd_cve')]}"/>
                        <field name="fetch_interval"/>
                        <field name="active"/>
                        <field name="last_fetch"/>
                        <field name="alert_count"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_security_alert_source" model="ir.actions.act_window">
        <field name="name">Alert Sources</field>
        <field name="res_model">security.alert.source</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
