<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_security_software_tree" model="ir.ui.view">
        <field name="name">security.software.tree</field>
        <field name="model">security.software</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="version"/>
                <field name="software_type"/>
                <field name="vendor"/>
                <field name="active"/>
                <field name="alert_count"/>
            </list>
        </field>
    </record>
    <record id="view_security_software_form" model="ir.ui.view">
        <field name="name">security.software.form</field>
        <field name="model">security.software</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_title">
                        <field name="icon" widget="image" class="oe_avatar"/>
                        <h1><field name="name"/> <field name="version" class="oe_inline"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="software_type"/>
                            <field name="vendor"/>
                            <field name="cpe_name"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <group string="Hierarchy">
                        <field name="parent_id"/>
                        <field name="dependency_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Usage"><field name="usage_description" nolabel="1"/></group>
                    <group string="Related Alerts"><field name="alert_ids" nolabel="1"><list><field name="name"/><field name="severity"/><field name="state"/></list></field></group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_security_software_kanban" model="ir.ui.view">
        <field name="name">security.software.kanban</field>
        <field name="model">security.software</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="version"/>
                <field name="software_type"/>
                <field name="icon"/>
                <field name="alert_count"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_image">
                                <img t-att-src="kanban_image('security.software', 'icon', record.id.raw_value)"
                                     t-if="record.icon.raw_value" width="48" height="48" class="o_image_48"/>
                            </div>
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div class="text-muted"><field name="version"/></div>
                                <div class="o_kanban_tags" t-if="record.alert_count.raw_value and record.alert_count.raw_value > 0">
                                    <span class="badge bg-danger"><t t-esc="record.alert_count.value"/> varningar</span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>
    <record id="action_security_software" model="ir.actions.act_window">
        <field name="name">Software Inventory</field>
        <field name="res_model">security.software</field>
        <field name="view_mode">kanban,list,form</field>
    </record>
</odoo>
