<odoo>
    <data>

        <record id="view_mgmtsystem_nonconformity_qr_tree" model="ir.ui.view">
            <field name="name">mgmtsystem.nonconformity.qr.tree</field>
            <field name="model">mgmtsystem.nonconformity.qr</field>
            <field name="arch" type="xml">
                <list>
                    <field name="system_id"/>
                    <field name="department_id"/>
                    <field name="responsible_user_id"/>
                    <field name="manager_user_id"/>
                </list>
            </field>
        </record>

        <record id="view_mgmtsystem_nonconformity_qr_form" model="ir.ui.view">
            <field name="name">mgmtsystem.nonconformity.qr.form</field>
            <field name="model">mgmtsystem.nonconformity.qr</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <div name="button_box" id="button_box" class="oe_button_box"/>
                        <field name="qr_code" widget="image" class="oe_avatar" invisible="qr_code == False"/>
                        <group>
                            <group>
                                <field name="system_id"/>
                                <field name="origin_ids" widget="many2many_tags"/>
                                <field name="url" widget="url"/>
                            </group>
                            <group>
                                <field name="department_id"/>
                                <field name="responsible_user_id"/>
                                <field name="manager_user_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_mgmtsystem_nonconformity_action" model="ir.actions.act_window">
            <field name="name">Nonconformity QR</field>
            <field name="res_model">mgmtsystem.nonconformity.qr</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="action_mgmtsystem_nonconformity_menu" action="action_mgmtsystem_nonconformity_action" parent="mgmtsystem.menu_mgmtsystem_configuration" sequence="1"/>

    </data>
</odoo>

