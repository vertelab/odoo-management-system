<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="nonconformity_form_temp" name="Management Nonconformity">
        <t t-call="website.layout">
            <div id="wrap">
                <div class="container py-2">

                    <div class="row">
<!--                        <div class="col-12 col-xl-auto order-xl-2 d-none d-xl-block">-->
<!--                            <t t-call="website_sale.cart_summary">-->
<!--                                <t t-set="hide_promotions">True</t>-->
<!--                                <t t-set="redirect" t-valuef="/shop/address"/>-->
<!--                            </t>-->
<!--                        </div>-->
                        <div class="col-12 col-xl order-xl-1">
                            <div>

                                <t t-if="request.params.get('status')">
                                    <div t-attf-class="alert alert-#{request.params.get('status') == 'success' and 'success' or 'danger'}" role="alert">
                                        <t t-if="request.params.get('status') == 'success'">
                                            Your nonconformity report has been successfully submitted.
                                        </t>
                                        <t t-else="">
                                            An error occurred while submitting your nonconformity report. Please try again.
                                        </t>
                                    </div>
                                </t>

                                <form t-att-action="'/nonconformity-qr/%s' %(nonconformity_qr.id)" enctype="multipart/form-data" method="post">
                                    <div class="row">
                                        <div t-attf-class="mb-3 col-lg-12">
                                            <label class="col-form-label" for="name">Name</label>
                                            <input type="text" name="name" t-attf-class="form-control" required="" />
                                        </div>
                                        <div class="w-100"/>

                                        <div t-attf-class="mb-3 col-lg-12">
                                            <label class="col-form-label" for="phone">Description</label>
                                            <textarea col="2" name="description" t-attf-class="form-control" required=""/>
                                        </div>

                                        <div class="w-100"/>
                                        <div t-attf-class="mb-3 col-lg-12">
                                            <label class="col-form-label" for="media">Image/Video</label>
                                            <input type="file" name="media" t-attf-class="form-control" required="" multiple="multiple" />
                                        </div>
                                    </div>

                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()" t-nocache="The csrf token must always be up to date."/>

                                    <div class="d-flex justify-content-between">
                                        <button type="submit" class="btn btn-primary mt8">Submit</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

